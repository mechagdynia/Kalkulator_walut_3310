{
  "name": "waluta-3310",
  "private": true,
  "version": "1.0.0",
  "description": "Bezpieczny kalkulator walut Web/PWA/Android/iOS w stylistyce Neo-Retro LCD.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:qa": "tsc --noEmit && vite build --configLoader runner && vitest run --configLoader runner",
    "cap:sync": "tsc --noEmit && vite build --configLoader runner && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
